# =================================
# PenRoseBlog 环境变量示例（请复制为 .env 再填写）
# 注意：不要把真实密钥提交到仓库
# =================================

# --- 数据库 ---
DB_PASSWORD=your_mysql_root_password
DB_USER=root
DB_HOST=mysql

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EXCHANGE=blog.notifications
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# --- JWT ---
# 至少 32 字节（HS256）强度的随机字符串
JWT_SECRET=please_generate_a_strong_secret

# --- Tencent COS ---
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET_REGION=ap-hongkong
COS_BUCKET_NAME=your_bucket_name
COS_CDN_URL=https://your-cdn-or-cos-domain
COS_ENABLE_ACCELERATE=true

# --- AI (DeepSeek/OpenAI-compatible) ---
DEEPSEEK_API_KEY=your_ai_api_key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# 可选：模型名（若后端读取 AI_MODEL）
AI_MODEL=deepseek-reasoner
